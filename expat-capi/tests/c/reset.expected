== reset after a document, then another
    xmldecl 1.0 -
    <a> user=u1
    text [x]
    </a>
  parse first -> 1
  after: error=0 @1:29 byte=29 userdata=u1 base=base1
  reset -> 1
  reset: error=0 @1:0 byte=-1 userdata=(null) base=(null)
  parse without handlers -> 1
  after: error=0 @1:8 byte=8 userdata=(null) base=(null)
    <c> user=(null)
    text [z]
    </c>
  parse with handlers again -> 1
== reset after an error
    <a> user=(null)
    <b> user=(null)
  parse bad -> 0
  after: error=7 @1:8 byte=8 userdata=(null) base=(null)
  reset -> 1
  reset: error=0 @1:0 byte=-1 userdata=(null) base=(null)
    <a> user=(null)
    </a>
  parse good -> 1
  after: error=0 @1:4 byte=4 userdata=(null) base=(null)
== reset in the middle of a document
    <a> user=(null)
    text [some]
  partway: error=0 @1:7 byte=7 userdata=(null) base=(null)
  reset -> 1
    <n> user=(null)
    text [new]
    </n>
  parse new -> 1
  after: error=0 @1:10 byte=10 userdata=(null) base=(null)
== reset after a stop
  stop -> 1
  parse more -> 0
  stopped: error=36 @1:3 byte=3 userdata=(null) base=(null)
  reset -> 1
    <s> user=(null)
    </s>
  parse new -> 1
== reset with an encoding
  reset -> 1
    <l> user=(null)
    text [café]
    </l>
  parse latin-1 -> 1
  reset -> 1
    xmldecl 1.0 iso-8859-1
    <l> user=(null)
    text [café]
    </l>
  parse declared latin-1 -> 1
  reset -> 1
    <l> user=(null)
    text [café]
    </l>
  parse now UTF-8 again -> 1
== a namespace parser stays one
    <urn:x|a> user=(null)
    </urn:x|a>
  parse first -> 1
  reset -> 1
    <urn:y|b> user=(null)
    </urn:y|b>
  parse second -> 1
== unknown encoding data is released
    xmldecl 1.0 x-enc
    unknown-encoding handler (data hd)
    <e> user=(null)
    text [Ӂ]
    </e>
  parse x-enc -> 1
  releases before reset: 0
    release
  reset -> 1
  releases after reset: 1
    xmldecl 1.0 x-enc
    unknown-encoding handler (data hd)
    <e> user=(null)
    </e>
  parse x-enc without a handler -> 1
    release
  releases after free: 2
== settings are cleared
    external entity: child reset -> 0
  parse with an external entity -> 1
  reset -> 1
    <r> user=(null)
    </r>
  parse the same, no handler now -> 1
== the foreign DTD setting
  reset -> 1
  parse no DOCTYPE -> 1
== the amplification limit
  parse entities -> 0
  -> limit on input amplification factor (from DTD and entities) breached
  reset -> 1
  parse entities after a reset -> 1
== a fresh parser, reset at once
  reset -> 1
  reset: error=0 @1:0 byte=-1 userdata=(null) base=(null)
    <f> user=(null)
    </f>
  parse doc -> 1
